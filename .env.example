# Copy to .env and fill in the secrets. Never commit .env (it's in .gitignore).
# Company name, website and team members are NOT here: edit config/team.yaml.

# ---- Shared company mailbox (FocusTrigger Automation) ----
# Gmail needs an APP PASSWORD, not the account password:
#   1. myaccount.google.com > Security > turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords > create one called "Lead outreach"
#   3. paste the 16-character code below (spaces are fine)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587                        # 587 = STARTTLS, 465 = SSL
SMTP_USER="focustriggerautomation@gmail.com"
SMTP_PASSWORD=""                     # the 16-character Gmail app password

IMAP_HOST="imap.gmail.com"           # read-only: detects replies + bounces
IMAP_USER="focustriggerautomation@gmail.com"
IMAP_PASSWORD=""                     # same app password as above

# ---- Optional: a team member sending from their OWN mailbox ----
# ID = their id in config/team.yaml, in UPPER_CASE. Without these lines the
# member sends from the shared mailbox above, with their own name.
# SMTP_PASSWORD_PRIYA=""
# SMTP_USER_PRIYA="priya@gmail.com"  # defaults to the member's email in team.yaml
# SMTP_HOST_PRIYA="smtp.gmail.com"
# IMAP_PASSWORD_PRIYA=""             # defaults to SMTP_PASSWORD_PRIYA

# Who signs new drafts when nobody passes --as (overrides team.yaml default_member)
DEFAULT_SENDER=""

# ---- LLM (free tiers) ----
LLM_PROVIDER="gemini"                # gemini | groq | xai | ollama | none
LLM_MODEL=""                         # blank = settings.yaml defaults with automatic fallback
GEMINI_API_KEY=""                    # https://aistudio.google.com/apikey
GROQ_API_KEY=""                      # https://console.groq.com
XAI_API_KEY=""                       # https://console.x.ai
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ---- Optional search ----
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""

# ---- Safety overrides ----
DAILY_SEND_LIMIT=25                  # per mailbox, rolling 24 hours
HUMAN_APPROVAL=true
DRY_RUN=true                         # set false once the drafts look right
