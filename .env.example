# Copy to .env and fill in. Never commit .env.

# ---- Sender identity (used in every email) ----
SENDER_NAME="Amartya"
SENDER_COMPANY="FocusTrigger Automation"
SENDER_EMAIL="you@gmail.com"
SENDER_WEBSITE="https://focustriggerautomation.com"
SENDER_PHONE=""                     # optional, shown in signature

# ---- SMTP ----
# Gmail: turn on 2-Step Verification, then create an App Password
#        (Google Account > Security > App passwords). Use it below, not your login password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587                       # 587 = STARTTLS, 465 = SSL
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
# Outlook / Microsoft 365: SMTP_HOST="smtp-mail.outlook.com" (personal) or
# "smtp.office365.com" (work). Microsoft is retiring password-based SMTP,
# so this may require an app password or may not work. Gmail is recommended.

# ---- IMAP (reads replies + bounces into the suppression list; read-only) ----
IMAP_HOST="imap.gmail.com"
IMAP_USER="you@gmail.com"
IMAP_PASSWORD="xxxx xxxx xxxx xxxx"

# ---- LLM (free tiers) ----
LLM_PROVIDER="gemini"               # gemini | groq | xai | ollama | none
LLM_MODEL=""                        # blank = default in settings.yaml
GEMINI_API_KEY=""                   # https://aistudio.google.com/apikey (free tier)
GROQ_API_KEY=""                     # https://console.groq.com (free tier)
XAI_API_KEY=""                      # https://console.x.ai (Grok; free credits vary)
OLLAMA_BASE_URL="http://localhost:11434/v1"   # fully local, no key

# ---- Optional search ----
GOOGLE_CSE_KEY=""                   # Programmable Search JSON API (free: 100 queries/day)
GOOGLE_CSE_CX=""

# ---- Safety overrides ----
DAILY_SEND_LIMIT=25
HUMAN_APPROVAL=true
DRY_RUN=true                        # start with true; set false when you're ready to send
